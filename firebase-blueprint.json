{
  "entities": {
    "Fact": {
      "title": "Fact",
      "description": "A fascinating fact about history, science, etc.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cat": { "type": "string", "enum": ["history", "science", "inventions", "discoveries", "birthdays"] },
        "emoji": { "type": "string" },
        "title": { "type": "string" },
        "year": { "type": "number" },
        "excerpt": { "type": "string" },
        "full": { "type": "string" },
        "featured": { "type": "boolean" },
        "imageUrl": { "type": "string" },
        "imageAlt": { "type": "string" },
        "imageCredit": { "type": "string" },
        "eventMonth": { "type": "number" },
        "eventDay": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["cat", "title", "year", "full"]
    },
    "Birthday": {
      "title": "Birthday",
      "description": "Information about a famous person's birthday.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "year": { "type": "number" },
        "field": { "type": "string" },
        "date": { "type": "string" },
        "color": { "type": "string" },
        "init": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "year", "field", "date"]
    },
    "QuizQuestion": {
      "title": "QuizQuestion",
      "description": "A quiz question generated by the user or AI.",
      "type": "object",
      "properties": {
        "q": { "type": "string" },
        "opts": { "type": "array", "items": { "type": "string" } },
        "correct": { "type": "number" },
        "cat": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["q", "opts", "correct", "cat"]
    },
    "Subscriber": {
      "title": "Subscriber",
      "description": "A newsletter subscriber.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "subscribedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "A message from the contact form.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "sentAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "subject", "message"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid"]
    }
  },
  "firestore": {
    "/facts/{factId}": {
      "schema": "Fact",
      "description": "Collection of interesting facts."
    },
    "/birthdays/{bdayId}": {
      "schema": "Birthday",
      "description": "Collection of famous birthdays."
    },
    "/quiz_questions/{qId}": {
      "schema": "QuizQuestion",
      "description": "Collection of quiz questions."
    },
    "/subscribers/{subId}": {
      "schema": "Subscriber",
      "description": "Newsletter subscribers."
    },
    "/contact_messages/{msgId}": {
      "schema": "ContactMessage",
      "description": "Messages from the contact form."
    },
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "User profile documents."
    }
  }
}

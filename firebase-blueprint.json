{
  "entities": {
    "Fact": {
      "title": "Fact",
      "description": "A fascinating fact about history, science, etc.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cat": { "type": "string", "enum": ["history", "science", "inventions", "discoveries", "birthdays"] },
        "emoji": { "type": "string" },
        "title": { "type": "string" },
        "year": { "type": "number" },
        "excerpt": { "type": "string" },
        "full": { "type": "string" },
        "featured": { "type": "boolean" },
        "imageUrl": { "type": "string" },
        "imageAlt": { "type": "string" },
        "imageCredit": { "type": "string" },
        "eventMonth": { "type": "number" },
        "eventDay": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["cat", "title", "year", "full"]
    },
    "Birthday": {
      "title": "Birthday",
      "description": "Information about a famous person's birthday.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "year": { "type": "number" },
        "field": { "type": "string" },
        "date": { "type": "string" },
        "color": { "type": "string" },
        "init": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "year", "field", "date"]
    },
    "QuizQuestion": {
      "title": "QuizQuestion",
      "description": "A quiz question generated by the user or AI.",
      "type": "object",
      "properties": {
        "q": { "type": "string" },
        "opts": { "type": "array", "items": { "type": "string" } },
        "correct": { "type": "number" },
        "cat": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["q", "opts", "correct", "cat"]
    },
    "Subscriber": {
      "title": "Subscriber",
      "description": "A newsletter subscriber.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "subscribedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "A message from the contact form.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "sentAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "subject", "message"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Server-provisioned administrator authorization marker.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "assignedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid"]
    },
    "AIDraft": {
      "title": "AIDraft",
      "description": "AI-generated educational drafts for admin review.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "cat": { "type": "string" },
        "emoji": { "type": "string" },
        "year": { "type": "number" },
        "excerpt": { "type": "string" },
        "full": { "type": "string" },
        "sourceTrend": { "type": "string" },
        "verificationStatus": { "type": "string" },
        "trustedSources": { "type": "array", "items": { "type": "string" } },
        "factCheckSummary": { "type": "string" },
        "examRelevance": { "type": "string" },
        "status": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "cat", "excerpt", "full", "status"]
    },
    "UserBookmark": {
      "title": "UserBookmark",
      "description": "User bookmarked article record stored in Firestore.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "factId": { "type": "string" },
        "factTitle": { "type": "string" },
        "factEmoji": { "type": "string" },
        "factCat": { "type": "string" },
        "factYear": { "type": "number" },
        "factExcerpt": { "type": "string" },
        "bookmarkedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "factId", "factTitle"]
    },
    "DailyCapsule": {
      "title": "DailyCapsule",
      "description": "Daily exam compendium and current affairs study capsule.",
      "type": "object",
      "properties": {
        "dateKey": { "type": "string" },
        "displayDate": { "type": "string" },
        "dayBadge": { "type": "string" },
        "themeTitle": { "type": "string" },
        "pdfFileName": { "type": "string" },
        "pdfFileSize": { "type": "string" },
        "pdfPageCount": { "type": "number" },
        "quickPointers": { "type": "array", "items": { "type": "string" } },
        "mcqs": { "type": "array", "items": { "type": "object" } },
        "currentAffairs": { "type": "array", "items": { "type": "object" } },
        "generatedAt": { "type": "string", "format": "date-time" },
        "isLiveAIGenerated": { "type": "boolean" }
      },
      "required": ["dateKey", "displayDate", "themeTitle", "mcqs", "currentAffairs"]
    },
    "QuizLeaderboardEntry": {
      "title": "QuizLeaderboardEntry",
      "description": "Leaderboard rank record for quiz participants.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "accuracy": { "type": "number" },
        "timeTakenSeconds": { "type": "number" },
        "quizDate": { "type": "string" },
        "category": { "type": "string" },
        "badge": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userName", "score", "totalQuestions", "accuracy", "quizDate"]
    },
    "ReadLaterItem": {
      "title": "ReadLaterItem",
      "description": "Article saved to user's personal Read Later reading list.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "articleId": { "type": "string" },
        "title": { "type": "string" },
        "excerpt": { "type": "string" },
        "category": { "type": "string" },
        "year": { "type": "number" },
        "emoji": { "type": "string" },
        "readStatus": { "type": "string", "enum": ["unread", "read"] },
        "savedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["articleId", "title", "category"]
    }
  },
  "firestore": {
    "/quiz_leaderboard/{entryId}": {
      "schema": "QuizLeaderboardEntry",
      "description": "Daily and all-time quiz top performers and scores."
    },
    "/daily_capsules/{capsuleId}": {
      "schema": "DailyCapsule",
      "description": "Daily exam prep capsules and syllabus-mapped compendiums."
    },
    "/users/{uid}/bookmarks/{bookmarkId}": {
      "schema": "UserBookmark",
      "description": "Bookmarked facts for user."
    },
    "/users/{uid}/read_later/{articleId}": {
      "schema": "ReadLaterItem",
      "description": "User's dedicated Read Later reading list."
    },
    "/ai_drafts/{draftId}": {
      "schema": "AIDraft",
      "description": "AI generated educational content drafts for admin approval."
    },
    "/facts/{factId}": {
      "schema": "Fact",
      "description": "Collection of interesting facts."
    },
    "/birthdays/{bdayId}": {
      "schema": "Birthday",
      "description": "Collection of famous birthdays."
    },
    "/quiz_questions/{qId}": {
      "schema": "QuizQuestion",
      "description": "Collection of quiz questions."
    },
    "/subscribers/{subId}": {
      "schema": "Subscriber",
      "description": "Newsletter subscribers."
    },
    "/contact_messages/{msgId}": {
      "schema": "ContactMessage",
      "description": "Messages from the contact form."
    },
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "User profile documents."
    },
    "/admins/{adminId}": {
      "schema": "AdminRecord",
      "description": "Admin authorization marker documents."
    }
  }
}
